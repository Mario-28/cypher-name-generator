{
  "id": "cypher-name-generator",
  "title": "Cypher Name Generator",
  "description": "An extensible name and text generation subsystem for the Cypher System. Supports pluggable providers and optional Cypher GM Taskbar integration.",
  "version": "1.3.3",
  "type": "module",
  "authors": [{ "name": "Cypher Tools" }],
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "15"
  },
  "url": "https://github.com/Mario-28/cypher-name-generator",
  "manifest": "https://raw.githubusercontent.com/Mario-28/cypher-name-generator/main/module.json",
  "download": "https://github.com/Mario-28/cypher-name-generator/archive/refs/heads/main.zip",
  "relationships": {
    "systems": [
      {
        "id": "cyphersystem",
        "type": "system",
        "compatibility": { "minimum": "2" }
      }
    ],
    "optional": [
      {
        "id": "cypher-gm-taskbar",
        "type": "module",
        "compatibility": { "minimum": "3" },
        "reason": "Adds a quick-access button to the GM Taskbar for opening the Name Generator."
      }
    ]
  },
  "esmodules": ["scripts/module.js"],
  "styles": ["styles/name-generator.css"],
  "socket": false,
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "js"],
      "paths": ["styles", "scripts", "templates"]
    }
  }
}
